import { ProgressTrack, Glyph } from "controls.slint";
export struct DigitFrame { previous: string, current: string, changing: bool }
export component RollingTime inherits Rectangle {
    in property <bool> light-material: false;
    in property <[DigitFrame]> digits;
    in property <float> roll;
    in property <length> font-size: 31px;
    in property <color> ink: (root.light-material ? #202024 : white);
    clip: true;
    for digit[index] in root.digits: Rectangle {
        x: index * root.font-size * 0.62; width: root.font-size * 0.62; height: parent.height; clip: true;
        Text { width: parent.width; height: parent.height; font-size: root.font-size; font-weight: 600; color: root.ink; horizontal-alignment: center; text: digit.current; y: digit.changing ? -root.roll * parent.height : 0px; }
        if digit.changing && root.roll > 0.001: Text { width: parent.width; height: parent.height; font-size: root.font-size; font-weight: 600; color: root.ink; horizontal-alignment: center; text: digit.previous; y: (1 - root.roll) * parent.height; }
    }
}
export component WavyProgress inherits Rectangle {
    in property <bool> light-material: false;
    in property <float> ui-scale: 1;
    in property <float> value;
    in property <string> wave;
    in property <color> fill-color: (root.light-material ? #202024 : #e4e4ea);
    in property <color> track-color: (root.light-material ? #00000028 : #ffffff28);
    in property <bool> show-thumb: false;
    in property <color> thumb-color: (root.light-material ? #202024 : white);
    height: 3px * root.ui-scale;
    ProgressTrack { light-material: root.light-material; width: parent.width; height: parent.height; ui-scale: root.ui-scale; value: root.value; track-color: transparent; fill-color: transparent; show-thumb: root.show-thumb; thumb-color: root.thumb-color; }
    Rectangle { x: parent.width * min(1, max(0, root.value)); width: parent.width - self.x; height: parent.height; border-radius: self.height / 2; background: root.track-color; }
    Path { y: parent.height / 2 - 5px * root.ui-scale; width: parent.width; height: 10px * root.ui-scale; viewbox-width: parent.width / (1px * root.ui-scale); viewbox-height: 10; commands: root.wave; stroke: root.fill-color; stroke-width: 2px * root.ui-scale; fill: transparent; }
}
export component ChargingIcon inherits Rectangle {
    in property <bool> light-material: false;
    in property <float> ui-scale: 1;
    in property <float> burst;
    in property <color> ink;
    in property <length> font-size: 35px;
    Glyph { light-material: root.light-material; ui-scale: root.ui-scale; width: parent.width; height: parent.height; font-size: root.font-size; text: "\u{e83f}"; color: root.ink; opacity: 1 - 0.2 * Math.sin(root.burst * 180deg); }
}
// A bounded field behind the content; no clock when hidden or motion is disabled.
export component ChargingBackground inherits Rectangle {
    in property <bool> light-material: false;
    in property <bool> active: false;
    in property <bool> lit: false;
    in property <color> ink;
    in property <float> ui-scale: 1;
    in property <float> intensity: 0;
    in property <bool> connecting: true;
    in property <float> phase: 0;
    clip: true;
    Rectangle {
        x: -parent.width * 0.9; y: -parent.height;
        width: parent.width * 1.8; height: parent.height * 3;
        visible: root.lit; opacity: root.intensity;
        background: @radial-gradient(circle, root.ink.with-alpha(0.22) 0%, root.ink.with-alpha(0.10) 40%, root.ink.with-alpha(0) 100%);
    }
    for i in 36: Rectangle {
        private property <float> position: mod((root.connecting ? root.phase : 1 - mod(root.phase, 1)) + i * 0.618034, 1);
        private property <float> fade: min(1, self.position * 8, (1 - self.position) * 8);
        x: self.position * (parent.width + 12px * root.ui-scale) - 12px * root.ui-scale;
        y: (0.08 + mod(i * 0.381966, 0.84)) * max(0px, parent.height - self.height);
        width: (2 + mod(i * 7, 6)) * root.ui-scale * 1px;
        height: (1 + mod(i, 2) * 0.5) * root.ui-scale * 1px;
        border-radius: self.height / 2;
        background: root.ink;
        opacity: root.active ? root.intensity * self.fade * (0.12 + mod(i * 3, 5) * 0.035) : 0;
    }
}
