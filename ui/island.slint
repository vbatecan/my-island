                                auto-choice := TouchArea { changed pressed => { root.pointer-interaction(self.pressed); } clicked => { root.player-picker-open = false; root.choose-player(""); } }
                            }
                            for player[index] in root.media-players : LiquidSurface {
                                x: 0px; y: (index + 1) * (28 * root.scaled-pixel); width: parent.width; height: (28 * root.scaled-pixel); border-radius: (4 * root.scaled-pixel);
                                glass-exposure: self.absolute-position.y >= player-list.absolute-position.y
                                    && self.absolute-position.y + self.height <= player-list.absolute-position.y + player-list.height
                                    ? expanded-content.optical-exposure : 0;
                                glass-layer: 1; glass-pressed: player-choice.pressed;
                                background: player-choice.has-hover ? (root.light-material ? #00000018 : #ffffff18) : transparent;
                                Text { x: (9 * root.scaled-pixel); y: 0px; width: max(0px, parent.width - (43 * root.scaled-pixel)); height: (28 * root.scaled-pixel); text: player.label; color: (root.light-material ? #202024 : white); font-size: (11 * root.font-pixel); overflow: elide; vertical-alignment: center; }
                                Glyph { light-material: root.light-material; ui-scale: root.ui-scale; x: parent.width - (28 * root.scaled-pixel); y: (7 * root.scaled-pixel); width: (17 * root.scaled-pixel); height: (15 * root.scaled-pixel); text: player.playing ? "\u{e768}" : "\u{e769}"; font-size: (9 * root.scaled-pixel); color: (root.light-material ? #4b4b54 : #a6a6b3); }
                                player-choice := TouchArea { changed pressed => { root.pointer-interaction(self.pressed); } clicked => { root.player-picker-open = false; root.choose-player(player.id); } }
                            }
                        }
                    }
                    if !root.page-entering || root.page-opacity < 0.75 : TouchArea {
                        width: parent.width; height: parent.height;
                        clicked => {}
                    }
                }
            }
        }
    }
    }
    }
}
