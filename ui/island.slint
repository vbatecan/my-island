export { PluginManagerWindow, PluginListEntry, PluginActionEntry, PluginConfigEntry, PluginVisualNode } from "plugins.slint";
import { PluginView, PluginListEntry, PluginActionEntry, PluginConfigEntry, PluginVisualNode } from "plugins.slint";
export { SettingsWindow, NotificationApp } from "settings.slint";
export struct PlayerChoice { id: string, label: string, playing: bool }

import { TextButton, Glyph, QuietButton, PlaybackButton, Artwork, ProgressTrack } from "components/controls.slint";
export { LyricRow } from "components/lyrics.slint";
import { AnimatedLyrics, LyricRow } from "components/lyrics.slint";
export { LauncherResult } from "components/app-launcher.slint";
import { AppLauncher, LauncherResult } from "components/app-launcher.slint";

export component IslandWindow inherits Window {
    title: "Still Island";
    width: root.canvas-width * root.scaled-pixel;
    height: root.canvas-height * root.scaled-pixel;
    background: transparent;
    no-frame: true;
    default-font-family: "Segoe UI Variable";
    default-font-size: (13 * root.font-pixel);

    out property <bool> lyrics-gap-active: synced-lines.gap-active;
    in property <bool> answer-editing;
    in property <bool> answer-visible;
    in property <string> answer-value;
    in property <string> answer-detail;
    in property <bool> answer-busy;
    in property <bool> answer-error;
    in property <bool> app-launcher-mode: false;
    in property <[LauncherResult]> launcher-results;
    in-out property <string> launcher-text;
    in property <string> launcher-status;
    in property <bool> launcher-busy: false;
    in property <int> launcher-selected: 0;
    callback launcher-query(string);
    callback launcher-activate(int);
    callback launcher-navigate(int);
    callback launcher-dismiss();
    callback launcher-updated();
    public function launcher-focus() { app-search.focus-search(); }
    in property <string> page-label;
    in property <int> page-count: 0;
    in property <int> page-index: 0;
    out property <float> page-opacity: 1;
    private property <bool> page-entering: true;
    public function begin-page-switch() { root.page-entering = false; root.page-opacity = 0; }
    public function end-page-switch() { root.page-entering = true; root.page-opacity = 1; }
    animate page-opacity {
        duration: root.media-motion-enabled ? (root.page-entering ? 160ms : 90ms) / min(2, max(0.5, root.animation-speed)) : 0ms;
        easing: ease-out;
    }
    in property <float> animation-speed: 1;
    in property <float> ui-scale: 1;
    in property <float> text-scale: 1;
    private property <length> font-pixel: root.scaled-pixel * root.text-scale;
    in property <bool> media-motion-enabled: true;
    private property <bool> media-step-animated: false;
    private property <float> media-pulse: 0;
    out property <bool> media-change-active: root.media-pulse > 0.001;
    public function media-change() {
        if root.media-motion-enabled && ((root.compact-media && root.compact-reveal > 0.01) || (root.wide-media && root.reveal > 0.01)) && root.media-pulse <= 0.001 {
            root.media-step-animated = false;
            root.media-pulse = 1;
            if root.media-pulse > 0 { root.media-step-animated = true; root.media-pulse = 0; }
        }
    }
    changed media-motion-enabled => {
        if !self.media-motion-enabled { self.media-step-animated = false; self.media-pulse = 0; self.page-opacity = 1; }
    }
    animate media-pulse { duration: root.media-motion-enabled && root.media-step-animated ? 220ms / min(2, max(0.5, root.animation-speed)) : 0ms; easing: ease-out; }
    in property <float> canvas-width: 800;
    in property <float> canvas-height: 300;
    private property <length> scaled-pixel: 1px * root.ui-scale;

    in property <float> shape-width: 126;
    in property <float> shape-height: 32;
    in property <float> shape-radius: 16;
    in property <string> shape-path;
    in property <bool> form-notch: true;
    in property <float> shoulder: 8;
    in property <bool> battery-mode: false;
    in property <bool> compact-battery: false;
    in property <bool> battery-present: false;
    in property <string> battery-percent-label: "—";
    in property <string> battery-power-label: "Battery status unavailable";
    in property <float> battery-level: 0;
    callback open-battery();
    in property <float> reveal: 0;
    in property <float> compact-reveal: 0;
    in property <float> content-shift: 8;
    in property <bool> media-mode: false;
    in property <bool> volume-mode: false;
    in property <bool> playing: false;
    in property <int> volume: 0;
    in property <bool> volume-muted: false;
    in property <bool> volume-available: false;
    in property <bool> media-available: false;
    in property <bool> can-play-pause: false;
    in property <bool> can-previous: false;
    in property <bool> can-next: false;
    in property <bool> can-seek: false;
    in property <string> track-title: "No media session";
    in property <string> artist-name: "Open a music or video app";
    in property <string> media-source: "";
    in property <bool> lyrics-enabled: true;
    in property <bool> lyrics-loading: false;
    in property <bool> lyrics-available: false;
    in property <bool> lyrics-synced: false;
    in property <string> lyrics-status: "Open a track to find lyrics.";
    in property <string> lyrics-previous;
    in property <string> lyrics-current;
    in property <string> lyrics-next;
    in property <string> lyrics-plain;
    in property <[LyricRow]> lyrics-rows;
    in property <bool> lyrics-motion-enabled: true;
    out property <float> lyrics-visual-cursor: synced-lines.cursor;
    out property <float> lyrics-font-pixels: synced-lines.font-pixels;
    out property <bool> lyrics-motion-active: synced-lines.motion-active;
    public function move-lyrics(cursor: float, animated: bool) { synced-lines.move-to(cursor, animated); }
    public function stop-lyrics() { synced-lines.stop(); }
    public function lyric-font-size(index: float) -> float { return synced-lines.font-size-for-line(index); }
    callback lyrics-retry();
    callback lyrics-enable();
    callback lyrics-updated();
    in property <float> media-layout-width: 640;
    in property <float> media-layout-height: 216;
    private property <float> media-space: min(1, max(0, (root.shape-width - root.media-layout-width + 42) / 32), max(0, (root.shape-height - root.media-layout-height + 24) / 18));
    private property <bool> wide-media: root.media-mode && !root.notification-mode && !root.timer-mode && !root.battery-mode && !root.plugin-mode;
    private property <float> expanded-content-width: (root.wide-media || root.plugin-mode || root.app-launcher-mode) ? max(0, root.shape-width - 48) : 312;
    // Select the layout from its destination, so spring overshoot cannot briefly
    // introduce a second column on a narrow display.
    private property <bool> lyrics-visible: root.wide-media && root.media-layout-width >= 480;
    private property <float> lyrics-column-width: root.lyrics-visible ? (root.expanded-content-width - 24) * 0.46 : 0;
    private property <float> media-column-x: root.lyrics-visible ? root.lyrics-column-width + 24 : 0;
    private property <float> media-column-width: root.expanded-content-width - root.media-column-x;
    // Native wheel routing uses the same item geometry as the lyrics scroller.
    public function lyrics-scroll-hit(x: float, y: float) -> bool {
        let left = (island.x + island-pointer.x + body-clip.x + expanded-content.x + media-panel.x + lyrics-viewport.x + plain-lyrics-scroll.x) / root.scaled-pixel;
        let top = (island.y + island-pointer.y + body-clip.y + expanded-content.y + media-panel.y + lyrics-viewport.y + plain-lyrics-scroll.y) / root.scaled-pixel;
        return root.lyrics-visible && root.lyrics-available && !root.lyrics-synced && root.reveal * root.media-space > 0.25
            && x >= left && x < left + plain-lyrics-scroll.width / root.scaled-pixel
            && y >= top && y < top + plain-lyrics-scroll.height / root.scaled-pixel;
    }
    public function volume-scroll-hit(x: float, y: float) -> bool {
        let left = (island.x + island-pointer.x + body-clip.x + expanded-content.x) / root.scaled-pixel;
        let top = (island.y + island-pointer.y + body-clip.y + expanded-content.y) / root.scaled-pixel;
        let card-left = left + (launcher-panel.x + launcher-volume-card.x) / root.scaled-pixel;
        let card-top = top + (launcher-panel.y + launcher-volume-card.y) / root.scaled-pixel;
        let slider-left = left + (volume-panel.x + volume-slider.x) / root.scaled-pixel;
        let slider-top = top + (volume-panel.y + volume-slider.y) / root.scaled-pixel;
        return root.reveal * root.page-opacity > 0.25 && ((launcher-panel.visible
            && x >= card-left && x < card-left + launcher-volume-card.width / root.scaled-pixel
            && y >= card-top && y < card-top + launcher-volume-card.height / root.scaled-pixel)
            || (volume-panel.visible
            && x >= slider-left && x < slider-left + volume-slider.width / root.scaled-pixel
            && y >= slider-top && y < slider-top + volume-slider.height / root.scaled-pixel));
    }
    public function plugin-scroll-hit(x: float, y: float) -> bool {
        let left = (island.x + island-pointer.x + body-clip.x + expanded-content.x + plugin-panel.x + plugin-view-content.x + plugin-view.x) / root.scaled-pixel;
        let top = (island.y + island-pointer.y + body-clip.y + expanded-content.y + plugin-panel.y + plugin-view-content.y + plugin-view.y) / root.scaled-pixel;
        return root.plugin-mode && root.plugin-view-open && root.reveal * root.page-opacity > 0.25
            && root.plugin-view-height * root.text-scale > plugin-view.height / root.scaled-pixel + 0.5
            && x >= left && x < left + plugin-view.width / root.scaled-pixel
            && y >= top && y < top + plugin-view.height / root.scaled-pixel;
    }
    in property <[PlayerChoice]> media-players;
    in property <string> player-label: "Automatic";
    callback choose-player(string);
    in-out property <bool> player-picker-open: false;
    changed player-picker-open => { if self.player-picker-open { self.seeking = false; } }
    private property <bool> seeking: false;
    private property <float> seek-preview: 0;
    changed media-mode => { if !self.media-mode { self.player-picker-open = false; self.seeking = false; } }
    changed track-title => { self.seeking = false; }
    changed media-source => { self.seeking = false; }
    changed can-seek => { if !self.can-seek { self.seeking = false; } }
    changed duration-seconds => { self.seeking = false; }
    in property <string> service-status: "";
    in property <float> progress: 0;
    in property <string> elapsed-label: "0:00";
    in property <string> duration-label: "0:00";
    in property <image> artwork;
    in property <bool> has-artwork: false;
    // 0: solid, 1: transparent, 2: clipped frosted acrylic, 3: refracted glass.
    in property <int> appearance: 0;
    in property <float> tint-opacity: 0.55;
    in property <string> material-name: "Solid";
    in property <image> glass-texture;
    in property <bool> has-glass-texture: false;

    in property <bool> notification-mode: false;
    in property <bool> notification-compact: false;
    in property <string> notification-app: "";
    in property <string> notification-title: "";
    in property <string> notification-body: "";
    in property <int> notification-count: 0;
    in property <image> notification-icon;
    in property <bool> has-notification-icon: false;
    in property <bool> can-open-source: false;
    in property <int> pending-count: 0;
    in property <bool> compact-media: false;
    in property <bool> volume-feedback: false;
    private property <float> header-content-width: root.wide-media ? max(24, root.media-column-width - (root.volume-feedback ? 208 : root.pending-count > 0 ? 129 : 102)) : root.volume-feedback ? 104 : root.pending-count > 0 ? 183 : 210;
    in property <bool> pinned: false;
    callback toggle-pin();
    in property <bool> timer-mode: false;
    in property <bool> compact-timer: false;
    in property <bool> timer-finished: false;
    in property <bool> timer-running: false;
    in property <bool> timer-paused: false;
    in property <string> timer-label: "5:00";
    in property <float> timer-progress: 0;
    in-out property <int> timer-draft-minutes: 5;
    function configure-timer(minutes: int) {
        root.timer-draft-minutes = min(1440, max(1, minutes));
        root.timer-set-duration(root.timer-draft-minutes * 60);
    }
    callback open-timer();
    callback timer-toggle();
    callback timer-reset();
    callback timer-set-duration(int);
    callback expand-notification();
    callback open-source();
    callback hide-notification();
    callback settings-requested();
    callback escape();
    callback pointer-interaction(bool);
    callback pointer-moved(float, float);

    callback volume-updated(bool);
    callback notifications-updated();
    callback media-updated();
    callback backdrop-updated();
    in property <float> position-seconds: 0;
    in property <float> duration-seconds: 0;
    callback toggle();
    callback hover(bool);
    callback collapse();
    callback open-media();
    callback open-volume();
    callback play-pause();
    callback previous();
    callback next();
    callback volume-change(int);
    callback toggle-mute();
    callback seek(float);

    in property <bool> plugin-mode: false;
    in property <bool> compact-plugin: false;
    in property <string> plugin-title: "Integrations";
    in property <string> plugin-body: "";
    in property <bool> plugin-has-progress: false;
    in property <float> plugin-progress: 0;
    in property <color> plugin-accent: #6eda93;
    in property <float> plugin-layout-width: 432;
    callback plugin-page-select(string,string);
    callback plugin-page-ensure(string,string);
    callback plugin-summary-requested(string,string);
    in property <[PluginListEntry]> plugin-list;
    in property <[PluginActionEntry]> plugin-actions;
    in property <[PluginVisualNode]> plugin-nodes;
    in property <float> plugin-view-height: 104;
    in property <bool> plugin-view-open: false;
    callback open-plugins(); callback manage-plugins(); callback plugin-home();
    callback plugin-select(string); callback plugin-action(string,string,string);
    callback plugin-edit(); callback plugins-updated();
    callback plugin-visibility(bool);
    forward-focus: keyboard;
    // Geometry stays in design units; render dimensions and text are laid out
    // at their final size instead of stretching an intermediate texture.
    canvas := Rectangle {
        x: 0px; y: 0px; width: root.canvas-width * root.scaled-pixel; height: root.canvas-height * root.scaled-pixel;
    keyboard := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.escape(); return accept; }
            return reject;
        }
    }
    island := Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0;
        width: root.shape-width * root.scaled-pixel;
        height: root.shape-height * root.scaled-pixel;
        // Shape rendering includes the concave shoulders. Contents stay in the
        // central body, where a normal rectangle clip is sufficient.
        if (root.appearance == 2 || root.appearance == 3) && root.has-glass-texture : Image {
            x: -root.shoulder * root.scaled-pixel; y: 0px;
            width: parent.width + 2 * root.shoulder * root.scaled-pixel; height: parent.height;
            source: root.glass-texture; image-fit: fill;
        }
        Path {
            visible: root.form-notch;
            x: -root.shoulder * root.scaled-pixel; y: 0px;
            width: parent.width + 2 * root.shoulder * root.scaled-pixel; height: parent.height;
            viewbox-x: 0; viewbox-y: 0; fit: fill;
            viewbox-width: root.shape-width + 2 * root.shoulder;
            viewbox-height: root.shape-height;
            commands: root.shape-path;
            fill: root.appearance == 0 ? #000000 : rgba(0, 0, 0, min(1, max(0, root.tint-opacity)));
        }
        if root.appearance == 3 && root.form-notch : Path {
            x: -root.shoulder * root.scaled-pixel; y: 0px;
            width: parent.width + 2 * root.shoulder * root.scaled-pixel; height: parent.height;
            viewbox-x: 0; viewbox-y: 0; fit: fill;
            viewbox-width: root.shape-width + 2 * root.shoulder;
            viewbox-height: root.shape-height;
            commands: root.shape-path;
            stroke-width: root.scaled-pixel; stroke: #ffffff32;
            fill: @linear-gradient(145deg, #ffffff16 0%, #ffffff00 42%, #ffffff08 100%);
        }
        if !root.form-notch : Rectangle {
            width: parent.width; height: parent.height;
            border-radius: root.shape-radius * root.scaled-pixel;
            background: root.appearance == 0 ? #000000 : rgba(0, 0, 0, min(1, max(0, root.tint-opacity)));
        }
        if !root.form-notch && root.appearance == 3 : Rectangle {
            width: parent.width; height: parent.height;
            border-radius: root.shape-radius * root.scaled-pixel;
            border-width: root.scaled-pixel; border-color: #ffffff32;
            background: @linear-gradient(145deg, #ffffff16 0%, #ffffff00 42%, #ffffff08 100%);
        }
        island-pointer := TouchArea {
            // Observe hover before child controls handle their own pointer events.
            x: -root.shoulder * root.scaled-pixel;
            width: parent.width + 2 * root.shoulder * root.scaled-pixel; height: parent.height;
            clicked => { root.toggle(); }
            scroll-event => { return accept; }
            changed has-hover => { root.hover(self.has-hover); }
            changed pressed => { root.pointer-interaction(self.pressed); }
            changed mouse-x => { root.pointer-moved(self.mouse-x / root.scaled-pixel, self.mouse-y / root.scaled-pixel); }
            changed mouse-y => { root.pointer-moved(self.mouse-x / root.scaled-pixel, self.mouse-y / root.scaled-pixel); }

            body-clip := Rectangle {
                x: root.shoulder * root.scaled-pixel; y: 0px;
                width: root.shape-width * root.scaled-pixel; height: root.shape-height * root.scaled-pixel;
                border-top-left-radius: root.form-notch ? 0px : root.shape-radius * root.scaled-pixel;
                border-top-right-radius: root.form-notch ? 0px : root.shape-radius * root.scaled-pixel;
                border-bottom-left-radius: root.shape-radius * root.scaled-pixel;
                border-bottom-right-radius: root.shape-radius * root.scaled-pixel;
                clip: true;
                // Compact state keeps real system volume accessible without a large panel.
                Rectangle {
                    x: (parent.width - (184 * root.scaled-pixel)) / 2;
                    y: (parent.height - (30 * root.scaled-pixel)) / 2;
                    width: (184 * root.scaled-pixel); height: (30 * root.scaled-pixel);
                    opacity: root.compact-reveal;
                    visible: root.compact-reveal > 0.001 && !root.notification-compact && !root.compact-media && !root.compact-timer && !root.compact-plugin && !root.compact-battery;
                    QuietButton { ui-scale: root.ui-scale; interaction(down) => { root.pointer-interaction(down); }
                        x: -(3 * root.scaled-pixel); y: -root.scaled-pixel; width: (27 * root.scaled-pixel); height: (29 * root.scaled-pixel);
                        glyph: root.volume-muted ? "\u{e74f}" : "\u{e767}";
                        label: root.volume-muted ? "Unmute output" : "Mute output";
                        enabled: root.volume-available;
                        clicked => { root.toggle-mute(); }
                    }
                    Text { x: (34 * root.scaled-pixel); y: 0px; width: (110 * root.scaled-pixel); height: (18 * root.scaled-pixel); color: white; font-size: (12 * root.font-pixel); font-weight: 600; text: root.volume-muted ? "Muted" : "Volume"; }
                    Text { x: (140 * root.scaled-pixel); y: 0px; width: (44 * root.scaled-pixel); height: (18 * root.scaled-pixel); horizontal-alignment: right; color: #c4c4ca; font-size: (11 * root.font-pixel); text: root.volume-available ? root.volume + "%" : "—"; }
                    ProgressTrack { ui-scale: root.ui-scale; x: (34 * root.scaled-pixel); y: (23 * root.scaled-pixel); width: (150 * root.scaled-pixel); value: root.volume / 100; fill-color: root.volume-muted ? #96969e : #e7e7eb; }
                    compact-slider := TouchArea {
                        x: (34 * root.scaled-pixel); y: (16 * root.scaled-pixel); width: (150 * root.scaled-pixel); height: (14 * root.scaled-pixel);
                        enabled: root.volume-available;
                        changed pressed => { root.pointer-interaction(self.pressed); }
                        clicked => { root.volume-change(round(min(100, max(0, self.mouse-x / self.width * 100)))); }
                        moved => { if self.pressed { root.volume-change(round(min(100, max(0, self.mouse-x / self.width * 100)))); } }
                    }
                }

                if root.notification-compact : Rectangle {
                    x: (parent.width - (184 * root.scaled-pixel)) / 2; y: (parent.height - (30 * root.scaled-pixel)) / 2;
                    width: (184 * root.scaled-pixel); height: (30 * root.scaled-pixel); opacity: root.compact-reveal;
                    visible: root.compact-reveal > 0.001;
                    Artwork { ui-scale: root.ui-scale; x: 0px; y: (2 * root.scaled-pixel); width: (26 * root.scaled-pixel); height: (26 * root.scaled-pixel); artwork: root.notification-icon; has-artwork: root.has-notification-icon; placeholder-glyph: "\u{e7f4}"; }
                    Text { x: (36 * root.scaled-pixel); y: 0px; width: root.notification-count > 1 ? (116 * root.scaled-pixel) : (148 * root.scaled-pixel); height: (13 * root.scaled-pixel); text: root.notification-app; color: #b9b9c2; font-size: (10 * root.font-pixel); overflow: elide; }
                    Text { x: (36 * root.scaled-pixel); y: (15 * root.scaled-pixel); width: (148 * root.scaled-pixel); height: (15 * root.scaled-pixel); text: root.notification-title; color: white; font-size: (11 * root.font-pixel); font-weight: 600; overflow: elide; }
                    if root.notification-count > 1 : Text { x: (160 * root.scaled-pixel); y: 0px; width: (24 * root.scaled-pixel); height: (13 * root.scaled-pixel); horizontal-alignment: right; color: #b9b9c2; font-size: (9 * root.font-pixel); text: root.notification-count > 9 ? "9+" : root.notification-count; }
                    TouchArea {
                        changed pressed => { root.pointer-interaction(self.pressed); }
                        clicked => { root.expand-notification(); }
                    }
                }
                if root.compact-battery : Rectangle {
                    x: (parent.width - (184 * root.scaled-pixel)) / 2; y: (parent.height - (30 * root.scaled-pixel)) / 2;
                    width: (184 * root.scaled-pixel); height: (30 * root.scaled-pixel); opacity: root.compact-reveal;
                    visible: root.compact-reveal > 0.001;
                    Glyph { ui-scale: root.ui-scale; x: 0px; y: (3 * root.scaled-pixel); width: (28 * root.scaled-pixel); height: (24 * root.scaled-pixel); font-size: (21 * root.scaled-pixel); text: "\u{e83f}"; color: #dedee5; }
                    Text { x: (40 * root.scaled-pixel); y: 0px; width: (144 * root.scaled-pixel); height: (16 * root.scaled-pixel); text: root.battery-percent-label; color: white; font-size: (12 * root.font-pixel); font-weight: 600; }
                    Text { x: (40 * root.scaled-pixel); y: (17 * root.scaled-pixel); width: (144 * root.scaled-pixel); height: (13 * root.scaled-pixel); text: root.battery-power-label; color: #b8b8c1; font-size: (10 * root.font-pixel); overflow: elide; }
                    TouchArea { changed pressed => { root.pointer-interaction(self.pressed); } clicked => { root.open-battery(); } }
                }
                if root.compact-media : Rectangle {
                    x: (18 * root.scaled-pixel); y: (parent.height - self.height) / 2;
                    width: max(184 * root.scaled-pixel, parent.width - 36 * root.scaled-pixel); height: min(parent.height - 6 * root.scaled-pixel, 30 * root.font-pixel); opacity: root.compact-reveal;
                    visible: root.compact-reveal > 0.001;
                    Artwork { ui-scale: root.ui-scale; x: 0px; y: (parent.height - self.height) / 2 - 2 * root.scaled-pixel * root.media-pulse; opacity: 1 - 0.18 * root.media-pulse; width: (30 * root.scaled-pixel); height: (30 * root.scaled-pixel); artwork: root.artwork; has-artwork: root.has-artwork; }
                    Text { x: (40 * root.scaled-pixel); y: 0px; width: max(0px, parent.width - 76 * root.scaled-pixel); height: (16 * root.font-pixel); opacity: 1 - 0.22 * root.media-pulse; text: root.track-title; color: white; font-size: (11 * root.font-pixel); font-weight: 600; overflow: elide; }
                    Text { x: (40 * root.scaled-pixel); y: (16 * root.font-pixel); width: max(0px, parent.width - 76 * root.scaled-pixel); height: (12 * root.font-pixel); text: root.artist-name != "" ? root.artist-name : root.playing ? "Playing" : "Paused"; color: #b8b8c1; font-size: (9 * root.font-pixel); overflow: elide; }
