                        Rectangle { x: root.media-column-x * root.scaled-pixel - (12 * root.scaled-pixel); y: (4 * root.scaled-pixel); width: root.scaled-pixel; height: max(0px, parent.height - 12 * root.scaled-pixel); background: #ffffff16; visible: root.lyrics-visible; }
                        Rectangle {
                            x: root.media-column-x * root.scaled-pixel; y: (parent.height - self.height) / 2; width: root.media-column-width * root.scaled-pixel; height: min(parent.height, 157 * root.scaled-pixel);
                            Artwork { ui-scale: root.ui-scale; x: 0px; y: 0px; width: (56 * root.scaled-pixel); height: (56 * root.scaled-pixel); artwork: root.artwork; has-artwork: root.has-artwork; }
                            Text { x: (69 * root.scaled-pixel); y: 0px; width: max(0px, parent.width - (69 * root.scaled-pixel)); height: max(37, 36 * root.text-scale) * root.scaled-pixel; wrap: word-wrap; opacity: 1 - 0.22 * root.media-pulse; color: white; font-size: (15 * root.font-pixel); font-weight: 600; overflow: elide; text: root.media-available ? root.track-title : "No media session"; }
                            Text { x: (69 * root.scaled-pixel); y: (max(37, 36 * root.text-scale) + 2) * root.scaled-pixel; width: max(0px, parent.width - (69 * root.scaled-pixel)); height: (21 * root.scaled-pixel); color: #aaaab4; font-size: (12 * root.font-pixel); overflow: elide; text: root.service-status != "" ? root.service-status : root.media-available ? root.artist-name : "Start playback in a supported app"; }
                            QuietButton { ui-scale: root.ui-scale; interaction(down) => { root.pointer-interaction(down); } x: parent.width / 2 - (68 * root.scaled-pixel); y: (80 * root.scaled-pixel); width: (36 * root.scaled-pixel); height: (32 * root.scaled-pixel); glyph: "\u{e892}"; label: "Previous track"; enabled: root.media-available && root.can-previous; clicked => { root.previous(); } }
                            PlaybackButton { ui-scale: root.ui-scale; interaction(down) => { root.pointer-interaction(down); } x: parent.width / 2 - (21 * root.scaled-pixel); y: (76 * root.scaled-pixel); width: (42 * root.scaled-pixel); height: (37 * root.scaled-pixel); playing: root.playing; motion-enabled: root.media-motion-enabled && self.visible && ((root.compact-media && root.compact-reveal > 0.01) || (root.wide-media && root.reveal > 0.01)); motion-speed: root.animation-speed; label: root.playing ? "Pause playback" : "Play"; enabled: root.media-available && root.can-play-pause; clicked => { root.play-pause(); } }
                            QuietButton { ui-scale: root.ui-scale; interaction(down) => { root.pointer-interaction(down); } x: parent.width / 2 + (32 * root.scaled-pixel); y: (80 * root.scaled-pixel); width: (36 * root.scaled-pixel); height: (32 * root.scaled-pixel); glyph: "\u{e893}"; label: "Next track"; enabled: root.media-available && root.can-next; clicked => { root.next(); } }
                            Text { y: 113 * root.scaled-pixel; height: 14 * root.scaled-pixel; width: parent.width; font-size: 9 * root.font-pixel; color: #90909b; horizontal-alignment: center; text: root.duration-seconds <= 0 ? "Live / duration unavailable" : "Seeking unavailable in this player"; visible: root.media-available && (!root.can-seek || root.duration-seconds <= 0); overflow: elide; }
                            ProgressTrack { ui-scale: root.ui-scale; x: 0px; y: (126 * root.scaled-pixel); width: parent.width; value: root.seeking ? root.seek-preview : root.progress; show-thumb: root.seeking; thumb-color: white; }
                            seek-area := TouchArea {
                                x: 0px; y: (116 * root.scaled-pixel); width: parent.width; height: (22 * root.scaled-pixel);
                                enabled: root.media-available && root.can-seek && root.duration-seconds > 0;
                                accessible-role: slider; accessible-label: "Seek playback";
                                changed pressed => {
                                    root.pointer-interaction(self.pressed);
                                }
                                pointer-event(event) => {
                                    if event.kind == PointerEventKind.cancel {
                                        root.seeking = false;
                                    } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                                        root.seek-preview = min(1, max(0, self.mouse-x / self.width));
                                        root.seeking = true;
                                    } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.seeking {
                                        root.seeking = false;
                                        if self.enabled { root.seek(root.seek-preview); }
                                    }
                                }
                                moved => { if self.pressed { root.seek-preview = min(1, max(0, self.mouse-x / self.width)); } }
                            }
                            Text { x: 0px; y: (140 * root.scaled-pixel); width: (60 * root.scaled-pixel); height: (17 * root.scaled-pixel); color: #aaaab4; font-size: (9 * root.font-pixel); text: root.seeking ? floor(root.seek-preview * root.duration-seconds / 60) + ":" + (mod(floor(root.seek-preview * root.duration-seconds), 60) < 10 ? "0" : "") + mod(floor(root.seek-preview * root.duration-seconds), 60) : root.elapsed-label; }
                            Text { x: parent.width - (60 * root.scaled-pixel); y: (140 * root.scaled-pixel); width: (60 * root.scaled-pixel); height: (17 * root.scaled-pixel); horizontal-alignment: right; color: #aaaab4; font-size: (9 * root.font-pixel); text: root.duration-seconds > 0 ? root.duration-label : "—"; }
                        }
                    }

                    volume-panel := Rectangle {
                        visible: root.volume-mode && !root.notification-mode && !root.timer-mode && !root.battery-mode && !root.plugin-mode;
                        x: 0px; y: (33 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (96 * root.scaled-pixel);
                        QuietButton { ui-scale: root.ui-scale; interaction(down) => { root.pointer-interaction(down); }
                            x: -root.scaled-pixel; y: -(2 * root.scaled-pixel); width: (40 * root.scaled-pixel); height: (40 * root.scaled-pixel);
                            glyph: root.volume-muted ? "\u{e74f}" : "\u{e767}";
                            label: root.volume-muted ? "Unmute output" : "Mute output";
                            enabled: root.volume-available;
                            clicked => { root.toggle-mute(); }
                        }
                        Text { x: (52 * root.scaled-pixel); y: root.scaled-pixel; width: (165 * root.scaled-pixel); height: (29 * root.scaled-pixel); color: white; font-size: (16 * root.font-pixel); font-weight: 600; text: root.volume-muted ? "Muted" : "Output volume"; }
                        Text { x: (52 * root.scaled-pixel); y: (32 * root.scaled-pixel); width: (165 * root.scaled-pixel); height: (21 * root.scaled-pixel); overflow: elide; color: #aaaab4; font-size: (11 * root.font-pixel); text: root.volume-available ? "Default Windows output" : "No output device available"; }
                        Text { x: (224 * root.scaled-pixel); y: root.scaled-pixel; width: (88 * root.scaled-pixel); height: (42 * root.scaled-pixel); horizontal-alignment: right; color: white; font-size: (23 * root.font-pixel); text: root.volume-available ? root.volume + "%" : "—"; }
                        ProgressTrack { ui-scale: root.ui-scale; x: 0px; y: (62 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (6 * root.scaled-pixel); value: root.volume / 100; fill-color: root.volume-muted ? #96969e : #e4e4ea; show-thumb: true; thumb-size: (12 * root.scaled-pixel); thumb-color: root.volume-available ? white : #96969e; }
                        volume-slider := TouchArea {
                            x: 0px; y: (49 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (31 * root.scaled-pixel);
                            enabled: root.volume-available;
                            changed pressed => { root.pointer-interaction(self.pressed); }
                            clicked => { root.volume-change(round(min(100, max(0, self.mouse-x / self.width * 100)))); }
                            moved => { if self.pressed { root.volume-change(round(min(100, max(0, self.mouse-x / self.width * 100)))); } }
                        }
                        Text { x: 0px; y: (83 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (17 * root.scaled-pixel); overflow: elide; color: #a8a8b2; font-size: (9 * root.font-pixel); text: root.service-status == "" ? "Drag to adjust · tap speaker to mute" : root.service-status; }
                    }

                    if root.battery-mode : Rectangle {
                        x: 0px; y: (30 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (110 * root.scaled-pixel);
                        Glyph { ui-scale: root.ui-scale; x: 0px; y: (2 * root.scaled-pixel); width: (49 * root.scaled-pixel); height: (42 * root.scaled-pixel); font-size: (35 * root.scaled-pixel); text: "\u{e83f}"; color: #dedee5; }
                        Text { x: (65 * root.scaled-pixel); y: 0px; width: (247 * root.scaled-pixel); height: (54 * root.scaled-pixel); text: root.battery-percent-label; color: white; font-size: (30 * root.font-pixel); font-weight: 600; }
                        Text { x: (65 * root.scaled-pixel); y: (55 * root.scaled-pixel); width: (247 * root.scaled-pixel); height: (22 * root.scaled-pixel); text: root.battery-power-label; color: #b8b8c1; font-size: (12 * root.font-pixel); overflow: elide; }
                        ProgressTrack { ui-scale: root.ui-scale; x: 0px; y: (82 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (5 * root.scaled-pixel); value: root.battery-level; fill-color: #dcdce4; }
                        Text { x: 0px; y: (93 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (17 * root.scaled-pixel); text: "System battery · updated by Windows"; color: #92929f; font-size: (9 * root.font-pixel); }
                    }
                    if root.timer-mode && !root.notification-mode && !root.battery-mode && !root.plugin-mode : Rectangle {
                        x: 0px; y: (28 * root.scaled-pixel); width: (312 * root.scaled-pixel); height: (116 * root.scaled-pixel);
                        private property <length> heading-height: max(37, 39 * root.text-scale) * root.scaled-pixel;
                        Text { x: 0px; y: 0px; width: (176 * root.scaled-pixel); height: parent.heading-height; overflow: elide; text: root.timer-finished ? "Time is up" : root.timer-label; color: root.timer-finished ? #f1d795 : white; font-size: root.timer-finished ? (26 * root.font-pixel) : (31 * root.font-pixel); font-weight: 600; }
                        TextButton { ui-scale: root.ui-scale; text-scale: root.text-scale; x: (184 * root.scaled-pixel); y: (5 * root.scaled-pixel); width: (25 * root.scaled-pixel); height: (24 * root.scaled-pixel); label: "−"; enabled: !root.timer-running && root.timer-draft-minutes > 1; interaction(down) => { root.pointer-interaction(down); } clicked => { root.configure-timer(root.timer-draft-minutes - 1); } }
                        Text { x: (210 * root.scaled-pixel); y: (6 * root.scaled-pixel); width: (76 * root.scaled-pixel); height: (23 * root.scaled-pixel); text: root.timer-draft-minutes + " min"; color: #c3c3cc; font-size: (11 * root.font-pixel); horizontal-alignment: center; vertical-alignment: center; }
                        TextButton { ui-scale: root.ui-scale; text-scale: root.text-scale; x: (287 * root.scaled-pixel); y: (5 * root.scaled-pixel); width: (25 * root.scaled-pixel); height: (24 * root.scaled-pixel); label: "+"; enabled: !root.timer-running && root.timer-draft-minutes < 1440; interaction(down) => { root.pointer-interaction(down); } clicked => { root.configure-timer(root.timer-draft-minutes + 1); } }
                        ProgressTrack { ui-scale: root.ui-scale; x: 0px; y: parent.heading-height + 2 * root.scaled-pixel; width: (312 * root.scaled-pixel); height: (2 * root.scaled-pixel); value: root.timer-progress; track-color: #ffffff20; fill-color: root.timer-finished ? #f1d795 : #d5d5df; }
                        for minutes[index] in [1, 5, 15] : TextButton { ui-scale: root.ui-scale; text-scale: root.text-scale;
                            x: index * (59 * root.scaled-pixel); y: parent.heading-height + 10 * root.scaled-pixel; width: (52 * root.scaled-pixel); height: (20 * root.scaled-pixel);
                            label: minutes + " min"; enabled: !root.timer-running;
                            interaction(down) => { root.pointer-interaction(down); }
                            clicked => { root.configure-timer(minutes); }
                        }
                        Text { x: (182 * root.scaled-pixel); y: parent.heading-height + 10 * root.scaled-pixel; width: (130 * root.scaled-pixel); height: (18 * root.scaled-pixel); text: root.timer-running ? "Counting down" : root.timer-finished ? "Timer complete" : root.timer-paused ? "Paused" : "Ready when you are"; color: #9999a7; font-size: (10 * root.font-pixel); horizontal-alignment: right; }
                        TextButton { ui-scale: root.ui-scale; text-scale: root.text-scale; x: 0px; y: parent.heading-height + 34 * root.scaled-pixel; width: (150 * root.scaled-pixel); height: (27 * root.scaled-pixel); label: root.timer-running ? "Pause" : root.timer-finished ? "Restart" : root.timer-paused ? "Resume" : "Start"; interaction(down) => { root.pointer-interaction(down); } clicked => { root.timer-toggle(); } }
                        TextButton { ui-scale: root.ui-scale; text-scale: root.text-scale; x: (162 * root.scaled-pixel); y: parent.heading-height + 34 * root.scaled-pixel; width: (150 * root.scaled-pixel); height: (27 * root.scaled-pixel); label: "Reset"; interaction(down) => { root.pointer-interaction(down); } clicked => { root.timer-reset(); } }
                    }

                    if root.player-picker-open && root.media-mode && !root.timer-mode && !root.battery-mode && !root.plugin-mode : Rectangle {
                        x: root.media-column-x * root.scaled-pixel; y: (26 * root.scaled-pixel); width: root.media-column-width * root.scaled-pixel; height: (162 * root.scaled-pixel);
                        border-radius: (6 * root.scaled-pixel); background: #17171b; border-width: root.scaled-pixel; border-color: #ffffff22;
                        clip: true;
                        Flickable {
                            x: (4 * root.scaled-pixel); y: (3 * root.scaled-pixel); width: max(0px, parent.width - (8 * root.scaled-pixel)); height: parent.height - (6 * root.scaled-pixel);
                            content-width: self.width;
                            content-height: max(self.height, (root.media-players.length + 1) * (28 * root.scaled-pixel));
                            Rectangle {
                                x: 0px; y: 0px; width: parent.width; height: (28 * root.scaled-pixel); border-radius: (4 * root.scaled-pixel);
                                background: auto-choice.has-hover ? #ffffff18 : transparent;
                                Text { x: (9 * root.scaled-pixel); y: 0px; width: max(0px, parent.width - (18 * root.scaled-pixel)); height: (28 * root.scaled-pixel); text: "Automatic · follow playback"; color: #d8d8e1; font-size: (11 * root.font-pixel); overflow: elide; vertical-alignment: center; }
                                auto-choice := TouchArea { changed pressed => { root.pointer-interaction(self.pressed); } clicked => { root.player-picker-open = false; root.choose-player(""); } }
                            }
                            for player[index] in root.media-players : Rectangle {
                                x: 0px; y: (index + 1) * (28 * root.scaled-pixel); width: parent.width; height: (28 * root.scaled-pixel); border-radius: (4 * root.scaled-pixel);
                                background: player-choice.has-hover ? #ffffff18 : transparent;
                                Text { x: (9 * root.scaled-pixel); y: 0px; width: max(0px, parent.width - (43 * root.scaled-pixel)); height: (28 * root.scaled-pixel); text: player.label; color: white; font-size: (11 * root.font-pixel); overflow: elide; vertical-alignment: center; }
                                Glyph { ui-scale: root.ui-scale; x: parent.width - (28 * root.scaled-pixel); y: (7 * root.scaled-pixel); width: (17 * root.scaled-pixel); height: (15 * root.scaled-pixel); text: player.playing ? "\u{e768}" : "\u{e769}"; font-size: (9 * root.scaled-pixel); color: #a6a6b3; }
                                player-choice := TouchArea { changed pressed => { root.pointer-interaction(self.pressed); } clicked => { root.player-picker-open = false; root.choose-player(player.id); } }
                            }
                        }
                    }
                }
            }
        }
    }
    }
}
