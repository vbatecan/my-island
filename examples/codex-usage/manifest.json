{
  "id": "org.stillisland.codex-usage",
  "name": "Codex Usage",
  "version": "0.2.0",
  "api_version": 1,
  "entrypoint": "still-island-plugin-codex-usage.exe",
  "background": false,
  "capabilities": ["native_ui", "activities", "local_process:codex", "network:chatgpt.com", "network:api.openai.com"],
